---
import SlipPage from "../components/SlipPage.astro";
---
<SlipPage kind="odds5" path="/5-odds-today" h1="5 odds today" card="5 odds slip"
          title="5 odds tips today: accumulator with the chance it lands"
          description="Today's 5 odds accumulator from our highest-probability priced selections, with 1xBet prices and the model's chance that every leg lands.">
  <p class="lede">An accumulator built from today's highest-probability priced selections (each rated 60% or more), one per match, until the 1xBet price reaches 5.00. The more legs, the lower the chance the whole slip lands, and we show that chance on every slip.</p>
</SlipPage>
