---
// Placeholder until Phase 5 (accounts and Paystack). No form, and no personal data collected.
import Base from "../layouts/Base.astro";
---
<Base title="Sign up" description="Engrebodds accounts and Premium open in August 2027. Until then, every tip is free to check on the public track record." noindex>
  <div class="stack" style="max-width:68ch">
    <div>
      <h1>Accounts open in August 2027</h1>
      <p class="lede">There is nothing to sign up for yet, and we don't collect any of your details. Until Premium opens, we're proving the tips in public: every pick is graded after full time and stays on the record.</p>
    </div>
    <div class="row">
      <a class="btn pri" href="/track-record">See the track record</a>
      <a class="btn sec" href="/predictions">Today's free tips</a>
    </div>
    <p class="note">When accounts open you'll need to confirm you are 18 or older. Payments will run through a Nigerian payment provider, in naira, with no auto-renewal.</p>
  </div>
</Base>
