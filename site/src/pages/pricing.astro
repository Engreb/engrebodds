---
import Base from "../layouts/Base.astro";
import Plans from "../components/Plans.astro";
---
<Base title="Premium plans and prices" description="Engrebodds Premium: every prediction before kick-off, the banker, 2, 5 and 10 odds slips and the bet builder. Pay in naira; no auto-renewal. Opens August 2027.">
  <div class="stack">
    <div>
      <span class="eyebrow">Opens August 2027</span>
      <h1>Premium plans</h1>
      <p class="lede">Pay in naira by card, bank transfer or USSD. No auto-renewal: your access simply ends when the plan does.</p>
    </div>
    <Plans />
    <p class="note">Premium isn't on sale yet. Until August 2027 we are building a public, graded track record, so you can judge every tip, wins and losses, before paying anything. Prices may change before launch.</p>
  </div>
</Base>
