---
// Cumulative profit in units over priced graded tips, oldest first (as in the prototype). No-market-price tips have no units.
import { watDate } from "../lib/day";
import type { RecordRow } from "../lib/record";
interface Props { rows: RecordRow[] }
const priced = Astro.props.rows.filter((r) => r.profit_units != null).slice().reverse();
const W = 720, H = 220, pad = { l: 40, r: 12, t: 12, b: 26 };
let c = 0;
const pts = priced.map((r) => (c += Number(r.profit_units)));
const mn = Math.min(0, ...pts), mx = Math.max(0, ...pts), span = mx - mn || 1;
const x = (i: number) => pad.l + (pts.length > 1 ? i / (pts.length - 1) : 0) * (W - pad.l - pad.r);
const y = (v: number) => pad.t + (1 - (v - mn) / span) * (H - pad.t - pad.b);
const d = pts.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join("");
const step = Math.max(1, Math.ceil(span / 4));
const ticks: number[] = [];
for (let v = Math.ceil(mn / step) * step; v <= mx; v += step) ticks.push(v);
---
{pts.length < 2 ? (
  <div class="ledger"><div class="empty">The profit chart appears once at least two priced tips are graded.</div></div>
) : (
  <div class="tbl-wrap" style="padding:10px">
    <svg class="chart" viewBox={`0 0 ${W} ${H}`} style="width:100%;min-width:520px;height:auto" role="img"
         aria-label={`Cumulative profit: ${pts[pts.length - 1].toFixed(1)} units over ${pts.length} priced tips`}>
      {ticks.map((v) => (
        <>
          <line x1={pad.l} x2={W - pad.r} y1={y(v)} y2={y(v)} stroke="var(--line)" stroke-dasharray={v === 0 ? undefined : "3 4"} />
          <text x={pad.l - 6} y={y(v) + 4} text-anchor="end">{v}u</text>
        </>
      ))}
      <path d={`${d}L${x(pts.length - 1)} ${y(0)}L${x(0)} ${y(0)}Z`} fill="var(--accent)" fill-opacity=".1" />
      <path d={d} fill="none" stroke="var(--accent)" stroke-width="2" />
      <circle cx={x(pts.length - 1)} cy={y(pts[pts.length - 1])} r="4" fill="var(--accent)" />
      <text x={pad.l} y={H - 6}>{watDate(priced[0].kickoff_at)}</text>
      <text x={W - pad.r} y={H - 6} text-anchor="end">{watDate(priced[priced.length - 1].kickoff_at)}</text>
    </svg>
  </div>
)}
