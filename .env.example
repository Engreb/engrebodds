# Copy to .env and fill in. Never commit .env.

# API-Football key from https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Postgres connection string. Local default from `npx supabase start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Requests kept free for live jobs; batch jobs stop below this.
API_QUOTA_FLOOR=500
